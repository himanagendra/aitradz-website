---
import ohlcvData from '../data/ohlcv.json';
---

<div class="hero-chart-card">
  <div class="chart-header">
    <div class="chart-title">
      <span class="chart-ticker">NIFTY 50 INDEX</span>
      <span>Elliott Wave Analysis (Daily)</span>
    </div>
    <div class="chart-metrics">
      <div class="metric-item">
        <span class="metric-label">LTP:</span>
        <span class="metric-value text-accent">25,495.00</span>
      </div>
      <div class="metric-item">
        <span class="metric-label">Wave State:</span>
        <span class="metric-value">Impulse (W5)</span>
      </div>
    </div>
  </div>

  <div id="chart-container" class="chart-container"></div>
</div>

<script>
  import { createChart, ColorType } from 'lightweight-charts';
  import ohlcvData from '../data/ohlcv.json';

  const container = document.getElementById('chart-container');

  if (container) {
    const chart = createChart(container, {
      layout: {
        background: { type: ColorType.Solid, color: 'transparent' },
        textColor: '#94a3b8',
        fontSize: 12,
        fontFamily: 'Inter, system-ui, sans-serif',
      },
      grid: {
        vertLines: { color: 'rgba(255, 255, 255, 0.04)' },
        horzLines: { color: 'rgba(255, 255, 255, 0.04)' },
      },
      rightPriceScale: {
        borderColor: 'rgba(255, 255, 255, 0.1)',
      },
      timeScale: {
        borderColor: 'rgba(255, 255, 255, 0.1)',
        timeVisible: true,
      },
      crosshair: {
        vertLine: {
          color: '#00f090',
          width: 1,
          style: 3,
          labelBackgroundColor: '#141a29',
        },
        horzLine: {
          color: '#00f090',
          width: 1,
          style: 3,
          labelBackgroundColor: '#141a29',
        },
      },
      handleScroll: {
        mouseWheel: true,
        pressedMove: true,
      },
      handleScale: {
        axisPressedMove: true,
        mouseWheel: true,
        pinch: true,
      },
    });

    const series = chart.addCandlestickSeries({
      upColor: '#00f090',
      downColor: '#ef4444',
      borderVisible: false,
      wickUpColor: '#00f090',
      wickDownColor: '#ef4444',
    });

    series.setData(ohlcvData);
    chart.timeScale().fitContent();

    // Auto-resize handler
    const resizeObserver = new ResizeObserver((entries) => {
      if (entries.length === 0 || !entries[0].contentRect) return;
      const { width, height } = entries[0].contentRect;
      chart.applyOptions({ width, height });
    });

    resizeObserver.observe(container);
  }
</script>
